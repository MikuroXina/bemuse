{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "reviewers": ["MikuroXina"],
  "ignoreTests": false,
  "automerge": true,
  "major": {
    "automerge": false
  },
  "platformAutomerge": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 20,
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "minimumReleaseAge": "7 days",
  "fetchChangeLogs": "pr",
  "enabledManagers": ["npm", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "container:\\s*mcr\\.microsoft\\.com/playwright:(?<currentValue>v?[0-9.]+)-noble"
      ],
      "depNameTemplate": "mcr.microsoft.com/playwright",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "groupName": "Vite packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["vite", "**vite-plugin**", "@vitejs/**"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "Playwright packages",
      "matchPackageNames": [
        "playwright",
        "@playwright/**",
        "mcr.microsoft.com/playwright"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "Vitest packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/**"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "React Router packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["react-router", "@react-router/**"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "TanStack packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@tanstack/**"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "UI5 Web Components packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ui5/**"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "Cloudflare wrangler packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["wrangler", "@cloudflare/**"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "Docusaurus packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@docusaurus/**", "@tsconfig/docusaurus"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "@types/react",
        "react-dom",
        "@types/react-dom"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "Fortawesome",
      "matchPackageNames": ["@fortawesome/**"],
      "minimumReleaseAge": "7 days"
    }
  ],
  "npm": {
    "minimumReleaseAge": "7 days"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": ["C-security"],
    "assignees": ["MikuroXina"]
  },
  "extends": [":timezone(Asia/Tokyo)", "packages:eslint"],
  "schedule": ["on the first day of the week"]
}
